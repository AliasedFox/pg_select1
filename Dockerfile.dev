# The image every service in the local stack (`bun run up`) runs from: the workspace with its
# dependencies installed. Source is synced in by `docker compose watch`, not baked in for good.
FROM oven/bun:1.3-slim

WORKDIR /app
ENV DO_NOT_TRACK=1 STORYBOOK_DISABLE_TELEMETRY=1

COPY package.json bun.lock ./
COPY apps/backend/package.json apps/backend/
COPY apps/web/package.json apps/web/
COPY packages/shared/package.json packages/shared/
RUN bun install --frozen-lockfile

COPY . .
