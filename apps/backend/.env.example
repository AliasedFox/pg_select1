# Copy to `.env` for running the API outside Docker. `bun run up` sets these itself.

# pg_select1's own database (Postgres 15 or later). The local stack's is on port 5440.
DATABASE_URL="postgresql://select1:select1@localhost:5440/pg_select1"

# Port the API, and in production the web app, listen on.
PORT=3100

# Signs sessions and tokens: 32 characters or more, e.g. `openssl rand -base64 32`.
PG_SELECT1_SECRET_KEY="development-secret-key-not-for-production"

# The address people open pg_select1 at: sign-in only works from it, and invite links point at it.
# Required in production. Here, the web dev server.
PG_SELECT1_URL="http://localhost:5190"
