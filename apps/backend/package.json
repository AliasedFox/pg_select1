{
  "name": "@pg_select1/backend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/api.ts",
    "start": "bun src/cli.ts",
    "user:add": "bun src/cli.ts user add",
    "typecheck": "tsc",
    "test": "bun test",
    "db:emit": "DO_NOT_TRACK=1 bun --bun prisma contract emit",
    "db:plan": "DO_NOT_TRACK=1 bun --bun prisma migration plan --name",
    "db:migrate": "DO_NOT_TRACK=1 bun --bun prisma db migrate",
    "build:binary": "bun scripts/compile.ts"
  },
  "dependencies": {
    "@pg_select1/shared": "workspace:*",
    "@prisma/cli-engine": "0.10.0",
    "@prisma/orm-postgres": "8.0.0-rc.24",
    "better-auth": "^1.7.25",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "pg": "^8.23.1",
    "pg-boss": "^12.38.2",
    "prisma": "8.0.0-rc.34",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^12.2.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "testcontainers": "^12.2.1"
  }
}
