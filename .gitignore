# ---------------------------------------------------------------------------
# Dependencies
# ---------------------------------------------------------------------------
node_modules/
jspm_packages/
.pnpm-store/

# Yarn (berry)
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions
.yarn-integrity

# npm
.npm/
*.tgz

# ---------------------------------------------------------------------------
# Bun
# ---------------------------------------------------------------------------
# Note: bun.lock / bun.lockb SHOULD be committed.
.bun/
# Temporary files left behind by `bun build --compile`
.*.bun-build

# ---------------------------------------------------------------------------
# Build output
# ---------------------------------------------------------------------------
dist/
build/
out/
.output/
storybook-static/

# TypeScript
*.tsbuildinfo
next-env.d.ts

# Vite
.vite/
vite.config.js.timestamp-*
vite.config.ts.timestamp-*

# Next.js
.next/

# Monorepo tooling
.turbo/
.nx/cache
.nx/workspace-data

# Misc bundler caches
.cache/
.parcel-cache/

# ---------------------------------------------------------------------------
# Prisma
# ---------------------------------------------------------------------------
# Note: prisma/schema.prisma and prisma/migrations/ SHOULD be committed.
# Generated client when using a custom `output` path
generated/prisma/
src/generated/prisma/
# SQLite databases sometimes used for local Prisma experiments
prisma/*.db
prisma/*.db-journal

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------
# Local data directories (e.g. Docker volumes mounted into the repo)
pgdata/
.pgdata/
postgres-data/
.postgres/
docker/data/
# Dumps and backups
*.dump
*.backup
*.pgdump
*.sql.gz
.psql_history

# ---------------------------------------------------------------------------
# Environment & secrets
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key

# ---------------------------------------------------------------------------
# Testing & coverage
# ---------------------------------------------------------------------------
coverage/
*.lcov
.nyc_output/
test-results/
playwright-report/
blob-report/
playwright/.cache/

# ---------------------------------------------------------------------------
# Logs & runtime data
# ---------------------------------------------------------------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json
pids/
*.pid
*.seed
*.pid.lock

# ---------------------------------------------------------------------------
# Linters & tool caches
# ---------------------------------------------------------------------------
.eslintcache
.stylelintcache
.prettiercache
.node_repl_history

# ---------------------------------------------------------------------------
# Editors & OS
# ---------------------------------------------------------------------------
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
