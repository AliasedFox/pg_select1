# Dependencies
node_modules/

# Bun is the only package manager; keep other lockfiles out (bun.lock is committed)
package-lock.json
yarn.lock
pnpm-lock.yaml
bun.lockb

# Build output, the `bun build --compile` executables included
dist/
*.tsbuildinfo
.*.bun-build

# Storybook's static build
storybook-static/

# Vite
.vite/
vite.config.ts.timestamp-*

# Prisma 8: the contract's contract.json and contract.d.ts (src/prisma/generated/) and the
# migrations are committed, so nothing of Prisma's is ignored.

# Local Postgres data and dumps
pgdata/
*.dump
*.pgdump
*.sql.gz

# Environment files and secrets (keep the .env.example templates)
.env
.env.*
!.env.example
*.pem
*.key

# Tests
coverage/

# Logs
logs/
*.log

# Editors
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp

# OS
.DS_Store
Thumbs.db

# Personal agent settings (shared settings stay tracked)
.claude/settings.local.json
CLAUDE.local.md
